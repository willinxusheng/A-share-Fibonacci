<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.user.ashare.autopush</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <!-- 改为你 Mac 上 clone 出的仓库绝对路径（第3节 clone 默认是 ~/A-share-Fibonacci） -->
    <string>/Users/YOUR_USER/A-share-Fibonacci/push_to_github.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/YOUR_USER/A-share-Fibonacci</string>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>19</integer>
    <key>Minute</key>
    <integer>5</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/ashare_launchd.out</string>
  <key>StandardErrorPath</key>
  <string>/tmp/ashare_launchd.err</string>
</dict>
</plist>
